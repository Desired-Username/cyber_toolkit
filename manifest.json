{
  "manifest_version": 3,
  "name": "Cyber Toolkit",
  "version": "1.0.0",
  "description": "Right-click lookups for CVEs, IPs, domains, URLs, file hashes, and email addresses straight from selected text.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": [
    "https://services.nvd.nist.gov/*",
    "https://rdap.org/*",
    "https://ipwho.is/*",
    "https://www.virustotal.com/*",
    "https://api.abuseipdb.com/*",
    "https://api.greynoise.io/*",
    "https://urlhaus-api.abuse.ch/*",
    "https://threatfox-api.abuse.ch/*",
    "https://mb-api.abuse.ch/*",
    "https://cloudflare-dns.com/*",
    "https://emailrep.io/*",
    "https://urlscan.io/*",
    "https://crt.sh/*",
    "https://api.ssllabs.com/*",
    "https://internetdb.shodan.io/*",
    "https://archive.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
